{
  "manifest_version": 3,
  "name": "Session Canvas",
  "version": "1.0.0",
  "description": "A simplified Session Buddy-style link manager with collections, groups, notes, tags, and IndexedDB storage.",
  "permissions": [
    "tabs",
    "storage",
    "identity"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://hotels.cloudbeds.com/connect/*"
      ],
      "js": [
        "cloudbeds-calendar.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://sheets.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://hotels.cloudbeds.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_title": "Session Canvas",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
